#!/usr/bin/env python3
"""
androidemu 3.6.5 主启动脚本
- start: 启动网关服务 + 音频守护 + 后台拉取镜像
- stop: 停止容器
- status: 检查容器状态
"""
import os
import sys
import time
import subprocess
import signal

APP_DEST = os.environ.get("TRIM_APPDEST", "/var/apps/androidemu/target")
VAR_DIR = os.environ.get("TRIM_PKGVAR", "/var/apps/androidemu/var")
COMPOSE = os.path.join(APP_DEST, "docker", "docker-compose.yaml")
GATEWAY_PY = os.path.join(APP_DEST, "server", "gateway.py")
AUDIO_PY = os.path.join(APP_DEST, "server", "audio_fix.py")
GATEWAY_PID = os.path.join(VAR_DIR, "gateway.pid")
GATEWAY_LOG = os.path.join(VAR_DIR, "gateway.log")
RES_AUTOSWITCH_SH = os.path.join(APP_DEST, "scripts", "resolution_autoswitch.sh")
RES_AUTOSWITCH_PID = os.path.join(VAR_DIR, "resolution_autoswitch.pid")

os.makedirs(VAR_DIR, exist_ok=True)


def log(msg):
    try:
        with open(os.path.join(VAR_DIR, "main.log"), "a") as f:
            f.write("[%s] %s\n" % (time.strftime("%F %T"), msg))
    except Exception:
        pass


def run(cmd, timeout=60):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, timeout=timeout)
    except Exception as e:
        log("命令执行异常：%s -> %r" % (cmd, e))
        return None


def is_gateway_running():
    """检查网关是否真的在运行（PID + cmdline + socket）"""
    try:
        with open(GATEWAY_PID) as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            if b"gateway.py" not in f.read():
                return False
        # 额外检查 socket 是否存在且可连接
        sock_path = os.path.join(APP_DEST, "app.sock")
        if not os.path.exists(sock_path):
            return False
        return True
    except Exception:
        return False


def start_gateway():
    """3.0.3：网关自带守护循环与自愈（server/gateway.py supervise），这里只做幂等启动。
    健康时 start 不会重启（避免掐断在线会话），并会清理上一版遗留的网关进程。"""
    if not os.path.exists(GATEWAY_PY):
        log("未找到网关程序：%s" % GATEWAY_PY)
        return
    try:
        r = subprocess.run(["python3", GATEWAY_PY, "start"], capture_output=True, timeout=60,
                           env={**os.environ, "TRIM_APPDEST": APP_DEST, "TRIM_PKGVAR": VAR_DIR})
        out = (r.stdout or b"").decode("utf-8", "replace").strip()
        err = (r.stderr or b"").decode("utf-8", "replace").strip()
        log("网关启动：%s%s" % (out, (" ｜ " + err) if err else ""))
    except Exception as e:
        log("网关启动失败：%r" % (e,))


def stop_gateway():
    """3.0.3：按 PID 文件 + /proc/<pid>/cmdline 身份停止（不使用 pkill）。"""
    if not os.path.exists(GATEWAY_PY):
        return
    try:
        r = subprocess.run(["python3", GATEWAY_PY, "stop"], capture_output=True, timeout=60,
                           env={**os.environ, "TRIM_APPDEST": APP_DEST, "TRIM_PKGVAR": VAR_DIR})
        log("网关停止：%s" % (r.stdout or b"").decode("utf-8", "replace").strip())
    except Exception as e:
        log("网关停止失败：%r" % (e,))


def is_res_autoswitch_running():
    """检查分辨率自动切换守护是否在运行"""
    try:
        with open(RES_AUTOSWITCH_PID) as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            if b"resolution_autoswitch" not in f.read():
                return False
        return True
    except Exception:
        return False


def start_res_autoswitch():
    """启动分辨率自动切换守护（Go版本，架构自适应，幂等）"""
    if not os.path.exists(RES_AUTOSWITCH_SH):
        log("未找到分辨率自动切换脚本：%s" % RES_AUTOSWITCH_SH)
        return
    if is_res_autoswitch_running():
        log("分辨率自动切换守护已在运行，跳过")
        return
    try:
        proc = subprocess.Popen(
            ["bash", RES_AUTOSWITCH_SH],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            cwd=APP_DEST, start_new_session=True
        )
        with open(RES_AUTOSWITCH_PID, "w") as f:
            f.write(str(proc.pid))
        log("分辨率自动切换守护已启动（Go版本），PID=%d" % proc.pid)
    except Exception as e:
        log("分辨率自动切换守护启动失败：%r" % (e,))


def stop_res_autoswitch():
    """停止分辨率自动切换守护"""
    try:
        if is_res_autoswitch_running():
            with open(RES_AUTOSWITCH_PID) as f:
                pid = int(f.read().strip())
            os.kill(pid, signal.SIGTERM)
            log("分辨率自动切换守护已停止，PID=%d" % pid)
    except Exception as e:
        log("分辨率自动切换守护停止失败：%r" % (e,))
    finally:
        if os.path.exists(RES_AUTOSWITCH_PID):
            try:
                os.remove(RES_AUTOSWITCH_PID)
            except Exception:
                pass


def start():
    log("=== 启动 androidemu 3.6.5 ===")
    # GPU 权限释放
    gpu_script = os.path.join(APP_DEST, "scripts", "gpu_release.sh")
    if os.path.exists(gpu_script):
        run("bash %s --compose %s" % (gpu_script, COMPOSE), timeout=30)

    # 后台拉取镜像
    pull_script = os.path.join(APP_DEST, "scripts", "start_pull_bg.sh")
    if os.path.exists(pull_script):
        subprocess.Popen(["bash", pull_script], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # GPU udev 规则
    udev_script = os.path.join(APP_DEST, "scripts", "gpu_udev_rules.sh")
    if os.path.exists(udev_script):
        run("bash %s install" % udev_script, timeout=30)

    # 启动网关服务
    start_gateway()

    # 自动部署云手机 Agent 到安卓容器（幂等，已运行则跳过）
    agent_script = os.path.join(APP_DEST, "scripts", "agent_autodeploy.sh")
    if os.path.exists(agent_script):
        try:
            subprocess.Popen(
                ["bash", agent_script],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                cwd=APP_DEST, start_new_session=True
            )
            log("Agent 自动部署已启动")
        except Exception as e:
            log("Agent 自动部署启动失败：%r" % (e,))

    # 启动音频守护
    try:
        subprocess.Popen(
            ["python3", AUDIO_PY, "start"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            cwd=APP_DEST, start_new_session=True
        )
    except Exception as e:
        log("音频守护启动失败：%r" % (e,))

    # ADB 转发
    adb_script = os.path.join(APP_DEST, "scripts", "redroid_adb_forward.sh")
    if os.path.exists(adb_script):
        subprocess.Popen(["bash", adb_script, "install"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 3.8.4：启动分辨率自动切换守护（根据客户端设备类型自动切换分辨率）
    start_res_autoswitch()

    log("启动完成")


def stop():
    log("=== 停止 androidemu ===")
    if os.path.exists(COMPOSE):
        run("cd %s && docker compose -p androidemu stop -t 60" % os.path.dirname(COMPOSE), timeout=90)
    stop_gateway()
    stop_res_autoswitch()
    log("停止完成")


def status():
    result = run("docker ps --filter name=androidemu --format '{{.Names}}'", timeout=10)
    if result and b"androidemu-android" in result.stdout:
        sys.exit(0)
    sys.exit(3)


if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else "start"
    if action == "start":
        start()
    elif action == "stop":
        stop()
    elif action == "status":
        status()
    else:
        print("用法：%s {start|stop|status}" % sys.argv[0])
        sys.exit(1)
